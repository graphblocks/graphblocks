{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "scaffold",
    "serviceAccount",
    "rbac",
    "podAnnotations",
    "podLabels",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "anyOf": [
            { "const": "" },
            {
              "maxLength": 255,
              "pattern": "^(?:[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[0-9]{1,5})?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
            }
          ]
        },
        "tag": {
          "type": "string",
          "anyOf": [
            { "const": "" },
            { "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" }
          ]
        },
        "digest": {
          "type": "string",
          "anyOf": [
            { "const": "" },
            { "pattern": "^sha256:[0-9a-f]{64}$" }
          ]
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "releaseId",
        "accessNamespaces",
        "replicas",
        "args",
        "env"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "releaseId": { "type": "string", "minLength": 1 },
        "accessNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": {
          "type": "string",
          "anyOf": [
            { "const": "" },
            {
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            }
          ]
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "clusterWide", "rules"],
      "properties": {
        "create": { "type": "boolean" },
        "clusterWide": { "type": "boolean" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["apiGroups", "resources", "verbs"],
            "properties": {
              "apiGroups": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string" }
              },
              "resources": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "verbs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "get",
                    "list",
                    "watch",
                    "create",
                    "update",
                    "patch",
                    "delete"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": ["graphblocks.ai/deployment-scaffold-release-id"]
        }
      },
      "additionalProperties": { "type": "string" }
    },
    "podLabels": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "app.kubernetes.io/name",
            "app.kubernetes.io/component",
            "app.kubernetes.io/instance"
          ]
        }
      },
      "additionalProperties": { "type": "string" }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "requests": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scaffold": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        },
        "required": ["scaffold"]
      },
      "then": {
        "properties": {
          "image": {
            "properties": { "repository": { "minLength": 1 } },
            "oneOf": [
              {
                "properties": { "tag": { "minLength": 1 } },
                "required": ["tag"]
              },
              {
                "properties": {
                  "digest": { "pattern": "^sha256:[0-9a-f]{64}$" }
                },
                "required": ["digest"]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rbac": {
            "properties": { "create": { "const": true } },
            "required": ["create"]
          }
        },
        "required": ["rbac"]
      },
      "then": {
        "properties": {
          "rbac": { "properties": { "rules": { "minItems": 1 } } }
        },
        "anyOf": [
          {
            "properties": {
              "serviceAccount": {
                "properties": { "create": { "const": true } },
                "required": ["create"]
              }
            }
          },
          {
            "properties": {
              "serviceAccount": {
                "properties": { "name": { "minLength": 1 } },
                "required": ["name"]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "rbac": {
            "properties": { "clusterWide": { "const": true } },
            "required": ["clusterWide"]
          }
        },
        "required": ["rbac"]
      },
      "then": {
        "properties": {
          "rbac": {
            "properties": { "create": { "const": true } },
            "required": ["create"]
          }
        }
      }
    }
  ]
}
